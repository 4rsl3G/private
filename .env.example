PORT=5000
NODE_ENV=development

# URL publik untuk membangun link QR (tanpa ekstensi)
BASE_PUBLIC_WEB=localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pansa
DB_USER=root
DB_PASS=

# Security
JWT_SECRET=change_me_long_random
# 32 bytes hex (64 chars)
MASTER_KEY=

# Seed admin (run once)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASS=

# Defaults (auto insert to DB settings if empty)
DEFAULT_PREMIFY_BASEURL=https://premify.store/api/v1
DEFAULT_PREMIFY_APIKEY=
DEFAULT_QRIS_STATIC=
DEFAULT_INVOICE_TTL_MIN=20

# GoBiz
GOBIZ_API_BASE=

# Hardening
# window match mutasi after invoice created (minutes)
PAY_MATCH_WINDOW_MIN=20
# cleanup expired invoices interval seconds
CLEANUP_INTERVAL_SEC=60
# optional purge fulfilled/expired older than days (set 0 to disable)
PURGE_OLD_DAYS=0
